generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Company {
  id                  Int        @id @default(autoincrement())
  name                String
  businessDescription String     @db.Text
  targetCustomer      String     @db.Text
  salesProcess        String     @db.Text
  valueProposition    String     @db.Text
  commonObjections    Json
  competitors         Json
  toneGuidelines      String     @db.Text
  goals               Json
  createdAt           DateTime   @default(now())

  users               User[]
  scenarios           Scenario[]
}

model User {
  id           Int          @id @default(autoincrement())
  companyId    Int
  name         String
  email        String       @unique
  password     String
  createdAt    DateTime     @default(now())

  company      Company      @relation(fields: [companyId], references: [id])
  simulations  Simulation[]
}

model Scenario {
  id                Int          @id @default(autoincrement())
  companyId         Int
  title             String
  description       String?      @db.Text
  difficulty        String
  customerProfile   String       @db.Text
  propertyContext   String       @db.Text
  objections        Json
  successCriteria   Json
  createdAt         DateTime     @default(now())

  company           Company      @relation(fields: [companyId], references: [id])
  simulations       Simulation[]
}

model Simulation {
  id          Int          @id @default(autoincrement())
  userId      Int
  scenarioId  Int
  status      String       @default("ACTIVE")
  startedAt   DateTime     @default(now())
  endedAt     DateTime?
  finalScore  Int?
  summary     String?      @db.Text

  user        User         @relation(fields: [userId], references: [id])
  scenario    Scenario     @relation(fields: [scenarioId], references: [id])
  messages    Message[]
  evaluation  Evaluation?
}

model Message {
  id            Int          @id @default(autoincrement())
  simulationId  Int
  role          String
  content       String       @db.Text
  createdAt     DateTime     @default(now())

  simulation    Simulation   @relation(fields: [simulationId], references: [id])
}

model Evaluation {
  id                   Int        @id @default(autoincrement())
  simulationId         Int        @unique
  scoreTotal           Int
  scoreDiscovery       Int
  scoreEmpathy         Int
  scoreObjection       Int
  scoreClosing         Int
  strengths            Json
  mistakes             Json
  recommendations      Json
  chartData            Json
  summary              String     @db.Text

  simulation           Simulation @relation(fields: [simulationId], references: [id])
}